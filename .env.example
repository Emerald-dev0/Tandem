# ── Tandem Environment ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:  cp .env.example .env

# REQUIRED — get this from @BotFather on Telegram (see SETUP.md step 1)
BOT_TOKEN=

# Optional — your Telegram username (without @) so we can show you a personal welcome
# OWNER_TELEGRAM_USERNAME=

# How the bot receives updates:
#   polling  = bot checks Telegram every few seconds (best for local dev / laptop / VPS)
#   webhook  = Telegram pushes updates to your server (best for production)
BOT_MODE=polling

# Only used when BOT_MODE=webhook
# e.g. https://tandem.up.railway.app  (no trailing slash)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Port the webhook server listens on (default 3000)
PORT=3000

# ── Storage (Phase 2 — keeps data across cold starts) ──────────────
# Free, no card: Vercel project → Storage → Create → Upstash Redis.
# Vercel injects these two automatically. Without them the bot still
# runs, but accounts reset on every cold start.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Credential vault (Phase 2 — REQUIRED to connect providers) ──────
# 64 hex chars (32 bytes) — encrypts GitHub/Vercel/Cloudflare/Render
# tokens at rest. No terminal needed: send /connect to the bot and tap
# "Generate encryption key". Paste the value here, then redeploy.
# ENCRYPTION_KEY=
