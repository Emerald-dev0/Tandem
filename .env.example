# Tandem environment variables
# Copy this file into your environment (Vercel → Settings → Environment Variables).

# ─────────────────────────────────────────────────────────────────────
# REQUIRED — Core
# ─────────────────────────────────────────────────────────────────────

# Get this from @BotFather on Telegram (/newbot)
BOT_TOKEN=your-telegram-bot-token-here

# AES-256-GCM key for encrypting provider tokens in the vault (32 bytes = 64 hex chars).
# Generate a key in Telegram with the bot: send /connect and tap "Generate key".
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────
# Database (Neon Postgres — free, no card, via Vercel Marketplace)
# ─────────────────────────────────────────────────────────────────────

# Vercel → Storage → Neon Postgres → "Manage" in Vercel → this is injected
# automatically. Tandem accepts DATABASE_URL, POSTGRES_URL or
# POSTGRES_URL_NON_POOLING (Neon provides POSTGRES_URL / POSTGRES_URL_NON_POOLING).
# Without it Tandem still runs, but state lives in memory (lost every deploy).
DATABASE_URL=

# Optional: Upstash Redis as a fast cache layer. Tandem works without it.
# Get from https://console.upstash.com (free tier, no credit card).
REDIS_URL=
REDIS_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# OAuth (one-tap "Log in with…" connect flows — preferred over PATs)
# Create each app with callback URL: https://<your-domain>/api/oauth/callback
# Note: both naming styles work — OAUTH_GITHUB_CLIENT_ID and the bare
# GITHUB_CLIENT_ID are accepted and equivalent.
# ─────────────────────────────────────────────────────────────────────

# GitHub OAuth app (Settings → Developer settings → OAuth Apps → New)
# Scopes Tandem requests: repo workflow read:org user
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# GitHub App (Settings → Developer settings → GitHub Apps) — BEST for GitHub:
# gives installation tokens scoped to exactly the repos you pick.
# Also set the App's "Webhook URL" to https://<your-domain>/api/webhooks/github
# and its "Setup URL" / callback to https://<your-domain>/api/oauth/callback
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=        # the .pem contents (multi-line, or with \n escaped)
GITHUB_APP_SLUG=               # e.g. tandem-devops
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Vercel OAuth app (vercel.com → Settings → OAuth Apps → Create)
# Scopes Tandem uses: deployments:read deployments:write projects:read env:read env:write
OAUTH_VERCEL_CLIENT_ID=
OAUTH_VERCEL_CLIENT_SECRET=

# Cloudflare OAuth app (dash.cloudflare.com → My Profile → API Tokens → OAuth Apps)
# Scopes Tandem requests: user:read zone:read zone:write
OAUTH_CLOUDFLARE_CLIENT_ID=
OAUTH_CLOUDFLARE_CLIENT_SECRET=

# Render — API key only (no OAuth): https://dashboard.render.com → API Keys
RENDER_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Webhooks & cron
# ─────────────────────────────────────────────────────────────────────

# Shared secret for GitHub webhooks (X-Hub-Signature-256 verification).
# Set the same value in the GitHub App / repo webhook config.
GITHUB_WEBHOOK_SECRET=

# Bearer secret protecting /api/cron/digest (Vercel → Settings → Cron →
# this is auto-injected as CRON_SECRET on supported plans; otherwise set it).
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Deployment
# ─────────────────────────────────────────────────────────────────────

# Public HTTPS base of the deployment (used for OAuth callbacks and webhooks).
# On Vercel this is auto-detected from VERCEL_PROJECT_PRODUCTION_URL.
WEBHOOK_URL=https://your-app.vercel.app

# bot: use Telegram webhooks (Vercel)
# longpoll: long polling (VPS/Render deployments)
BOT_MODE=webhook

# Optional shared secret Telegram includes in webhook headers (defense in depth).
TELEGRAM_WEBHOOK_SECRET=change-me-in-production

# Optional comma-separated Telegram user IDs allowed to use the bot.
# If empty, anyone can use it (set OWNER_TELEGRAM_USERNAME to lock it down).
TELEGRAM_ALLOWED_USER_IDS=

# Telegram username (without @) that owns this instance. When set, nobody
# else can use the bot. Recommended once you're up and running.
OWNER_TELEGRAM_USERNAME=
